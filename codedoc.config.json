{
  "llm_mode": "api",
  "model_name": "gpt-4o-mini",
  "api_base_url": null,
  "entry_file": null,
  "output_dir": "docs_output",
  "output_format": "json",
  "supported_extensions": [
    ".py", ".ts", ".tsx", ".js", ".jsx",
    ".dart", ".java", ".cs", ".html"
  ],
  "parallel_agents": true,
  "log_level": "INFO",
  "max_file_size_kb": 500,
  "propagate_changes": true,
  "skip_dirs": [
    "myenv",
    ".venv",
    "venv",
    "env",
    "node_modules",
    "__pycache__",
    "docs_output"
  ],
  "ignore_paths": []
}
